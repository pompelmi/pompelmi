{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "rootDir": ".",
    "outDir": "./dist",
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "node_modules"]
}
