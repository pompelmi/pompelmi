---
/**
 * Props:
 * - title?: string
 * - description?: string
 * - image?: string (1200x630; absolute or under /public)
 * - noindex?: boolean
 * - canonical?: string
 * - ogType?: string
 * - jsonLd?: Record<string, any> | Record<string, any>[]
 */
const {
  title = 'Pompelmi — Inspect untrusted uploads before storage',
  description = 'Open-source upload security for Node.js. Inspect untrusted files before storage with checks for spoofing, archive abuse, risky document and binary signals, and optional YARA.',
  image = '/pompelmi/og.png',
  imageAlt = 'Pompelmi social preview: open-source upload security for Node.js',
  noindex = false,
  canonical: canonicalOverride,
  ogType = 'website',
  jsonLd = null,
  keywords = [],
  siteName = 'Pompelmi',
  author,
  publishedTime,
  modifiedTime,
  section,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') || '';
const path = Astro.url?.pathname || '/';
const canonical = canonicalOverride || (site ? new URL(path, site).toString() : undefined);
const ogImage = image.startsWith('http')
  ? image
    : site
      ? new URL(image.startsWith('/') ? image : `/${image}`, site).toString()
      : image;
const keywordList = Array.isArray(keywords)
  ? keywords.filter(Boolean)
  : String(keywords || '')
      .split(',')
      .map((value) => value.trim())
      .filter(Boolean);
const jsonLdNodes = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((node) => {
  if (!node || typeof node !== 'object') {
    throw new TypeError('SEOHead expects jsonLd to be an object or array of objects.');
  }

  return node;
});
const robots = noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large';
const serializeJsonLd = (node) =>
  JSON.stringify(node)
    .replace(/</g, '\\u003C')
    .replace(/>/g, '\\u003E')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#0f172a" />
<meta name="format-detection" content="telephone=no" />
{author && <meta name="author" content={author} />}
{keywordList.length > 0 && <meta name="keywords" content={keywordList.join(', ')} />}
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={ogType} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && author && <meta property="article:author" content={author} />}
{ogType === 'article' && section && <meta property="article:section" content={section} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLdNodes.length > 0 && (
  jsonLdNodes.map((node) => <script type="application/ld+json" set:html={serializeJsonLd(node)} />)
)}
