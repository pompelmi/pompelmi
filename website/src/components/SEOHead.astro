---
/**
 * Props:
 * - title?: string
 * - description?: string
 * - image?: string (1200x630; absolute or under /public)
 * - noindex?: boolean
 * - canonical?: string
 * - ogType?: string
 * - jsonLd?: Record<string, any> | Record<string, any>[]
 */
const {
  title = 'Pompelmi — File upload malware scanning for Node.js',
  description = 'Fast, safe file upload scanning for Node.js. Deep ZIP inspection, MIME/size policies, optional YARA, and ready-made adapters.',
  image = '/pompelmi/og.png',
  noindex = false,
  canonical: canonicalOverride,
  ogType = 'website',
  jsonLd = null,
} = Astro.props

const site = Astro.site?.toString().replace(/\/$/, '') || ''
const path = Astro.url?.pathname || '/'
const canonical = canonicalOverride || (site ? new URL(path, site).toString() : undefined)
const ogImage = image.startsWith('http')
  ? image
  : site
    ? new URL(image.startsWith('/') ? image : `/${image}`, site).toString()
    : image
---
<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content={ogType} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && (
  Array.isArray(jsonLd)
    ? jsonLd.map((node) => <script type="application/ld+json">{JSON.stringify(node)}</script>)
    : <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
)}
