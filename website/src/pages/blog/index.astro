---
import { getCollection } from 'astro:content';
import PublicLayout from '../../components/PublicLayout.astro';

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  });

const featuredLinks = [
  {
    href: '/pompelmi/use-cases/',
    title: 'Use cases',
    description: 'Document, image, PDF, archive, S3, CI/CD, and quarantine workflows.',
  },
  {
    href: '/pompelmi/comparisons/',
    title: 'Comparisons',
    description: 'Extension checks vs MIME sniffing, Pompelmi vs ClamAV, and cloud API tradeoffs.',
  },
  {
    href: '/pompelmi/getting-started/',
    title: 'Start here',
    description: 'Install the core package, pick a framework guide, and test the upload gate locally.',
  },
];

const formatDate = (date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<PublicLayout
  title="Blog — Pompelmi"
  description="Technical guides, decision pages, and upload-security deep dives for Node.js teams."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Blog</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">Technical guides for real upload routes</h1>
      <p class="mt-4 text-base leading-7 text-slate-600">
        The docs are the canonical integration surface. The blog covers decision pages, search-intent tutorials, and deeper explanations that help teams evaluate file upload security in Node.js without losing the privacy-first, in-process context.
      </p>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {featuredLinks.map((link) => (
        <a href={link.href} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow">
          <h2 class="text-lg font-semibold tracking-tight text-slate-950">{link.title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{link.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-10 grid gap-6">
      {blogPosts.map((post) => {
        const freshness = post.data.updatedDate ?? post.data.pubDate;
        return (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
              {post.data.category && <span>{post.data.category}</span>}
            </div>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950">
              <a href={`/pompelmi/blog/${post.slug}/`} class="hover:text-blue-700">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">{post.data.description}</p>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap gap-2">
                {(post.data.tags ?? []).slice(0, 4).map((tag) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">{tag}</span>
                ))}
              </div>
              <a href={`/pompelmi/blog/${post.slug}/`} class="text-sm font-medium text-blue-700 hover:text-blue-800">
                Read article
              </a>
            </div>
            <div class="sr-only">{freshness.toISOString()}</div>
          </article>
        );
      })}
    </div>
  </section>
</PublicLayout>
