---
import { getCollection } from 'astro:content';
import PublicLayout from '../../components/PublicLayout.astro';

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  });
const [featuredPost, ...remainingPosts] = blogPosts;
const toBlog = (id) => `/blog/${id}/`;

const featuredLinks = [
  {
    href: '/use-cases/',
    title: 'Use cases',
    description: 'Document, image, PDF, archive, S3, CI/CD, and quarantine workflows.',
  },
  {
    href: '/comparisons/',
    title: 'Comparisons',
    description: 'Extension checks vs MIME sniffing, Pompelmi vs ClamAV, and cloud API tradeoffs.',
  },
  {
    href: '/getting-started/',
    title: 'Start here',
    description: 'Install the core package, pick a framework guide, and test the upload gate locally.',
  },
];

const formatDate = (date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Pompelmi Blog',
  description: 'Technical guides, decision pages, and upload-security deep dives for Node.js teams.',
  url: 'https://pompelmi.app/blog/',
};
---

<PublicLayout
  title="Blog — Pompelmi"
  description="Technical guides, decision pages, and upload-security deep dives for Node.js teams."
  jsonLd={jsonLd}
  keywords={['pompelmi blog', 'node.js upload security blog', 'file upload security tutorials']}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="eyebrow">Blog</p>
      <h1 class="section-title">Technical guides for real upload routes</h1>
      <p class="section-copy">
        The docs are the canonical integration surface. The blog covers decision pages, search-intent tutorials, and deeper explanations that help teams evaluate file upload security in Node.js without losing the privacy-first, in-process context.
      </p>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1.08fr_0.92fr]">
      {featuredPost ? (
        <article class="surface-panel p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
            <span class="pill">{featuredPost.data.category ?? 'Latest article'}</span>
            <span>{formatDate(featuredPost.data.pubDate)}</span>
            {featuredPost.data.updatedDate && <span>Updated {formatDate(featuredPost.data.updatedDate)}</span>}
          </div>
          <h2 class="mt-5 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
            <a href={toBlog(featuredPost.id)} class="transition hover:text-sky-800">
              {featuredPost.data.title}
            </a>
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{featuredPost.data.description}</p>
          {(featuredPost.data.tags ?? []).length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {(featuredPost.data.tags ?? []).slice(0, 5).map((tag) => (
                <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <div class="mt-6">
            <a href={toBlog(featuredPost.id)} class="action-primary">Read the latest article</a>
          </div>
        </article>
      ) : (
        <div class="surface-panel-soft p-6">
          <p class="eyebrow">No posts yet</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950">Blog content is on the way.</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            The docs are already available if you want to start integrating Pompelmi now.
          </p>
        </div>
      )}

      <div class="space-y-4">
        {featuredLinks.map((link) => (
          <a href={link.href} class="list-card block p-5">
            <h2 class="text-lg font-semibold tracking-tight text-slate-950">{link.title}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{link.description}</p>
          </a>
        ))}
      </div>
    </div>

    {(featuredPost ? remainingPosts : blogPosts).length > 0 && (
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {(featuredPost ? remainingPosts : blogPosts).map((post) => {
        const freshness = post.data.updatedDate ?? post.data.pubDate;
        return (
          <article class="grid-card p-6">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
              {post.data.category && <span>{post.data.category}</span>}
            </div>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950">
              <a href={toBlog(post.id)} class="transition hover:text-sky-800">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">{post.data.description}</p>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap gap-2">
                {(post.data.tags ?? []).slice(0, 4).map((tag) => (
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700">
                    {tag}
                  </span>
                ))}
              </div>
              <a href={toBlog(post.id)} class="text-sm font-medium text-sky-800 transition hover:text-sky-950">
                Read article
              </a>
            </div>
            <div class="sr-only">{freshness.toISOString()}</div>
          </article>
        );
        })}
      </div>
    )}
  </section>
</PublicLayout>
