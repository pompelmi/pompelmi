---
import { getCollection, render } from 'astro:content';
import PublicLayout from '../../components/PublicLayout.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const postTags = new Set(post.data.tags ?? []);
const relatedPosts = allPosts
  .filter((candidate) => candidate.id !== post.id && (candidate.data.tags ?? []).some((tag) => postTags.has(tag)))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 3);

const formatDate = (date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const published = formatDate(post.data.pubDate);
const updated = post.data.updatedDate ? formatDate(post.data.updatedDate) : null;
const authorName = post.data.author ?? 'Pompelmi Team';
const articleUrl = `https://pompelmi.app/blog/${post.id}/`;
const nextSteps = [
  {
    href: '/getting-started/',
    title: 'Start with the docs',
    note: 'Pick a framework guide and wire your first upload route.',
  },
  {
    href: 'https://github.com/pompelmi/pompelmi/tree/main/examples',
    title: 'Browse examples',
    note: 'See runnable Express, Next.js, NestJS, and storage-flow examples.',
  },
  {
    href: 'https://github.com/pompelmi/pompelmi',
    title: 'Inspect the source',
    note: 'Review packages, release history, and implementation details.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      author: {
        '@type': 'Organization',
        name: authorName,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Pompelmi',
        logo: {
          '@type': 'ImageObject',
          url: 'https://pompelmi.app/logo.svg',
        },
      },
      mainEntityOfPage: articleUrl,
      url: articleUrl,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://pompelmi.app/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://pompelmi.app/blog/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
          item: articleUrl,
        },
      ],
    },
  ],
};
---

<PublicLayout
  title={`${post.data.title} — Pompelmi Blog`}
  description={post.data.description}
  jsonLd={jsonLd}
  ogType="article"
  keywords={[...(post.data.tags ?? []), 'pompelmi', 'node.js upload security']}
  author={authorName}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  section={post.data.category ?? 'Blog'}
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
    <nav class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog/" class="hover:text-slate-900">Blog</a>
      <span class="mx-2">/</span>
      <span>{post.data.title}</span>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
      <article class="surface-panel p-6 sm:p-10">
        <header class="border-b border-slate-200 pb-8">
          <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
            <span class="pill">{post.data.category ?? 'Article'}</span>
            <span>{published}</span>
            {updated && <span>Updated {updated}</span>}
          </div>
          <h1 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">{post.data.title}</h1>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">{post.data.description}</p>
          {(post.data.tags ?? []).length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="prose-public mt-8">
          <Content />
        </div>
      </article>

      <aside class="space-y-4 lg:pt-3">
        <div class="surface-panel-soft p-6 lg:sticky lg:top-28">
          <p class="eyebrow">Article details</p>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="font-semibold text-slate-950">Published</dt>
              <dd class="mt-1 text-slate-600">{published}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-950">Updated</dt>
              <dd class="mt-1 text-slate-600">{updated ?? 'Original publication date'}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-950">Author</dt>
              <dd class="mt-1 text-slate-600">{authorName}</dd>
            </div>
            {post.data.category && (
              <div>
                <dt class="font-semibold text-slate-950">Category</dt>
                <dd class="mt-1 text-slate-600">{post.data.category}</dd>
              </div>
            )}
          </dl>

          <div class="mt-6">
            <p class="eyebrow">Continue with Pompelmi</p>
            <div class="mt-4 space-y-3">
              {nextSteps.map((item) => (
                <a
                  href={item.href}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noopener' : undefined}
                  class="list-card block p-4"
                >
                  <h2 class="text-base font-semibold tracking-tight text-slate-950">{item.title}</h2>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{item.note}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>

    {relatedPosts.length > 0 && (
      <section class="mt-10">
        <p class="eyebrow">Keep reading</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950">Related articles</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {relatedPosts.map((related) => (
            <a href={`/blog/${related.id}/`} class="grid-card p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                {formatDate(related.data.updatedDate ?? related.data.pubDate)}
              </p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-950">{related.data.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{related.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </section>
</PublicLayout>
