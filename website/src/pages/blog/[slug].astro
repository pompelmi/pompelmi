---
import { getCollection } from 'astro:content';
import PublicLayout from '../../components/PublicLayout.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');
const postTags = new Set(post.data.tags ?? []);
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug && (candidate.data.tags ?? []).some((tag) => postTags.has(tag)))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 3);

const formatDate = (date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const published = formatDate(post.data.pubDate);
const updated = post.data.updatedDate ? formatDate(post.data.updatedDate) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author ?? 'Pompelmi Team',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Pompelmi',
    logo: {
      '@type': 'ImageObject',
      url: 'https://pompelmi.github.io/pompelmi/logo.svg',
    },
  },
  mainEntityOfPage: `https://pompelmi.github.io/pompelmi/blog/${post.slug}/`,
};
---

<PublicLayout
  title={`${post.data.title} — Pompelmi Blog`}
  description={post.data.description}
  jsonLd={jsonLd}
  ogType="article"
>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <style>
      .article-body {
        color: #334155;
        line-height: 1.8;
      }
      .article-body h2,
      .article-body h3,
      .article-body h4 {
        color: #0f172a;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
      }
      .article-body p,
      .article-body ul,
      .article-body ol,
      .article-body table,
      .article-body pre,
      .article-body blockquote {
        margin-top: 1rem;
      }
      .article-body ul,
      .article-body ol {
        padding-left: 1.25rem;
      }
      .article-body li {
        margin-top: 0.5rem;
      }
      .article-body code {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.35rem;
        color: #0f172a;
        padding: 0.15rem 0.35rem;
        font-size: 0.92em;
      }
      .article-body pre {
        background: #0f172a;
        border-radius: 1rem;
        color: #e2e8f0;
        overflow-x: auto;
        padding: 1rem 1.2rem;
      }
      .article-body pre code {
        background: transparent;
        border: none;
        color: inherit;
        padding: 0;
      }
      .article-body a {
        color: #1d4ed8;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .article-body table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
      }
      .article-body th,
      .article-body td {
        border: 1px solid #e2e8f0;
        padding: 0.75rem;
        text-align: left;
        vertical-align: top;
      }
      .article-body th {
        background: #f8fafc;
        color: #0f172a;
      }
      .article-body blockquote {
        border-left: 4px solid #cbd5e1;
        color: #475569;
        padding-left: 1rem;
      }
    </style>
    <nav class="text-sm text-slate-500">
      <a href="/pompelmi/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <a href="/pompelmi/blog/" class="hover:text-slate-900">Blog</a>
      <span class="mx-2">/</span>
      <span>{post.data.title}</span>
    </nav>

    <article class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
      <header class="border-b border-slate-200 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
          <span>{published}</span>
          {updated && <span>Updated {updated}</span>}
          {post.data.category && <span>{post.data.category}</span>}
        </div>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">{post.data.title}</h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{post.data.description}</p>
        {(post.data.tags ?? []).length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="article-body mt-8">
        <Content />
      </div>
    </article>

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Continue with Pompelmi</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-950">Turn the article into a real upload path</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        <a href="/pompelmi/getting-started/" class="rounded-2xl border border-slate-200 p-4 hover:border-blue-300">
          <h3 class="font-semibold text-slate-950">Docs</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Install the core package, pick a framework guide, and start with a single route.</p>
        </a>
        <a href="https://github.com/pompelmi/pompelmi/tree/main/examples" target="_blank" rel="noopener" class="rounded-2xl border border-slate-200 p-4 hover:border-blue-300">
          <h3 class="font-semibold text-slate-950">Examples</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">See runnable Express, Next.js, NestJS, and workflow examples in the repository.</p>
        </a>
        <a href="https://github.com/pompelmi/pompelmi" target="_blank" rel="noopener" class="rounded-2xl border border-slate-200 p-4 hover:border-blue-300">
          <h3 class="font-semibold text-slate-950">GitHub</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Star the repo, inspect the source, and follow package releases and examples.</p>
        </a>
      </div>
    </section>

    {relatedPosts.length > 0 && (
      <section class="mt-8">
        <h2 class="text-xl font-semibold tracking-tight text-slate-950">Related articles</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {relatedPosts.map((related) => (
            <a href={`/pompelmi/blog/${related.slug}/`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                {formatDate(related.data.updatedDate ?? related.data.pubDate)}
              </p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-950">{related.data.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{related.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </section>
</PublicLayout>
