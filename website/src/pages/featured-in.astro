---
import PublicLayout from '../components/PublicLayout.astro';
import mentionsData from '../../../mentions/mentions.json';

const groups = [
  { title: 'Curated lists', sourceTypes: ['awesome-list'] },
  { title: 'Newsletters and roundups', sourceTypes: ['newsletter'] },
  { title: 'Interviews and media coverage', sourceTypes: ['other'] },
];

const sortedItems = [...mentionsData.items].sort((a, b) => {
  if (!a.date && !b.date) return a.title.localeCompare(b.title);
  if (!a.date) return 1;
  if (!b.date) return -1;
  return b.date.localeCompare(a.date);
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Featured in',
  description:
    'Selected newsletters, awesome lists, and media coverage that mention Pompelmi.',
  url: 'https://pompelmi.github.io/pompelmi/featured-in/',
};
---

<PublicLayout
  title="Featured in — Pompelmi"
  description="Selected newsletters, awesome lists, and media coverage that mention Pompelmi."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">External proof</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">Featured in</h1>
      <p class="mt-4 text-base leading-7 text-slate-600">
        A small set of public references that help new teams evaluate the project quickly. This page is generated from the repository&apos;s mentions data, so the website and README stay aligned.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 text-sm">
        <a href="/pompelmi/getting-started/" class="rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-900 hover:bg-white">
          Start with the docs
        </a>
        <a href="https://github.com/pompelmi/pompelmi/tree/main/examples" target="_blank" rel="noopener" class="rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-900 hover:bg-white">
          Browse examples
        </a>
        <a href="https://github.com/pompelmi/pompelmi" target="_blank" rel="noopener" class="rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-900 hover:bg-white">
          Visit the repo
        </a>
      </div>
    </div>

    <div class="mt-10 space-y-10">
      {groups.map((group) => {
        const items = sortedItems.filter((item) => group.sourceTypes.includes(item.sourceType));
        if (items.length === 0) return null;
        return (
          <section>
            <h2 class="text-xl font-semibold tracking-tight text-slate-950">{group.title}</h2>
            <div class="mt-4 grid gap-4">
              {items.map((item) => (
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                  <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
                    <span>{item.publisher}</span>
                    {item.date && <span>{item.date}</span>}
                  </div>
                  <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-950">
                    <a href={item.url} target="_blank" rel="noopener" class="hover:text-blue-700">
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{item.snippet}</p>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</PublicLayout>
