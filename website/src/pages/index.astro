---
import PublicLayout from '../components/PublicLayout.astro';
import mentionsData from '../../../mentions/mentions.json';

const quickStartSnippet = `npm install pompelmi`;

const startPaths = [
  { href: '/pompelmi/how-to/express/', label: 'Express', note: 'Multer + upload guard' },
  { href: '/pompelmi/how-to/nextjs/', label: 'Next.js', note: 'App Router route handler' },
  { href: '/pompelmi/how-to/nestjs/', label: 'NestJS', note: 'Module + interceptor' },
  { href: '/pompelmi/how-to/fastify/', label: 'Fastify', note: 'preHandler upload gate' },
  { href: '/pompelmi/how-to/koa/', label: 'Koa', note: 'Middleware-first route' },
  { href: '/pompelmi/how-to/nuxt-nitro/', label: 'Nuxt/Nitro', note: 'scanBytes in Nitro' },
  { href: '/pompelmi/use-cases/cicd-artifact-scanning/', label: 'CI/CD', note: 'Scan artifacts before promotion' },
  { href: '/pompelmi/tutorials/secure-s3-presigned-uploads-with-malware-scanning/', label: 'S3 / object storage', note: 'Quarantine then promote' },
];

const useCases = [
  { href: '/pompelmi/use-cases/document-upload-security/', title: 'Document uploads', note: 'PDF and Office workflows with review-friendly handling.' },
  { href: '/pompelmi/use-cases/image-upload-security/', title: 'Image uploads', note: 'Raster routes, SVG separation, and storage decisions.' },
  { href: '/pompelmi/use-cases/archive-zip-upload-security/', title: 'ZIP and archive uploads', note: 'Depth, expansion, entry-count, and traversal controls.' },
  { href: '/pompelmi/use-cases/quarantine-inspect-first-store-later/', title: 'Quarantine workflows', note: 'Inspect first, store later, and promote only after review.' },
];

const orientation = [
  {
    href: '/pompelmi/comparisons/extension-checks-vs-mime-sniffing-vs-content-inspection/',
    title: 'Why not just extension checks?',
    note: 'Because filenames and client MIME claims are only the outermost layer.',
  },
  {
    href: '/pompelmi/comparisons/pompelmi-vs-clamav-for-file-uploads/',
    title: 'Why not just ClamAV?',
    note: 'Signature scanning helps, but the upload gate still needs route-level and structural controls.',
  },
  {
    href: '/pompelmi/comparisons/pompelmi-vs-cloud-malware-scanning-apis/',
    title: 'Why not a cloud API?',
    note: 'Sending files to a third party changes the privacy and latency story for every upload.',
  },
];

const featuredMentions = [...mentionsData.items]
  .filter((item) => item.date)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4);

const worksWith = [
  'pompelmi',
  '@pompelmi/express-middleware',
  '@pompelmi/next-upload',
  '@pompelmi/nestjs-integration',
  '@pompelmi/fastify-plugin',
  '@pompelmi/koa-middleware',
  '@pompelmi/cli',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Pompelmi',
      url: 'https://github.com/pompelmi/pompelmi',
      sameAs: ['https://github.com/pompelmi/pompelmi'],
    },
    {
      '@type': 'SoftwareSourceCode',
      name: 'Pompelmi',
      description:
        'In-process file upload security for Node.js. Inspect untrusted files before storage with local-first checks and optional YARA.',
      programmingLanguage: ['TypeScript', 'JavaScript'],
      runtimePlatform: 'Node.js',
      codeRepository: 'https://github.com/pompelmi/pompelmi',
      license: 'https://opensource.org/licenses/MIT',
    },
  ],
};
---

<PublicLayout
  title="Pompelmi — In-process file upload security for Node.js"
  description="Inspect untrusted files before storage with local-first checks for spoofed files, archive abuse, risky document structures, and optional YARA."
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Open-source core · MIT · Node.js 18+</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-6xl">
          In-process file upload security for Node.js.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
          Pompelmi is an upload gate for teams that want to inspect untrusted files before storage. It focuses on the application layer: spoofed file types, archive abuse, risky document structures, and optional YARA when you need more specific matching.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/pompelmi/getting-started/" class="rounded-md bg-slate-950 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800">
            Start with the docs
          </a>
          <a href="https://github.com/pompelmi/pompelmi/tree/main/examples" target="_blank" rel="noopener" class="rounded-md border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-900 hover:bg-slate-50">
            Browse examples
          </a>
          <a href="https://github.com/pompelmi/pompelmi/stargazers" target="_blank" rel="noopener" class="rounded-md border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-900 hover:bg-slate-50">
            Star on GitHub
          </a>
        </div>
        <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Install</p>
          <pre class="mt-3 overflow-x-auto rounded-xl bg-slate-950 px-4 py-4 text-sm text-slate-100"><code>{quickStartSnippet}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Choose your path</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Start from your framework or workflow</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {startPaths.map((path) => (
          <a href={path.href} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow">
            <h3 class="text-lg font-semibold tracking-tight text-slate-950">{path.label}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{path.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Who it is for</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Teams that need a real upload boundary</h2>
          <div class="mt-6 space-y-4 text-sm leading-7 text-slate-600">
            <p>Good fits include public or semi-trusted upload endpoints, privacy-sensitive systems, document-heavy business flows, and product teams that want upload checks inside the application path rather than behind a cloud dependency.</p>
            <p>Pompelmi is not presented as a full antivirus replacement. It is an application-layer control that works well on its own, or alongside YARA, ClamAV, and broader storage or review workflows.</p>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Works with</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            {worksWith.map((pkg) => (
              <li class="rounded-md border border-slate-200 bg-white px-3 py-2 font-mono">{pkg}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Use cases</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Problem-first pages for real upload flows</h2>
      </div>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {useCases.map((useCase) => (
          <a href={useCase.href} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow">
            <h3 class="text-lg font-semibold tracking-tight text-slate-950">{useCase.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{useCase.note}</p>
          </a>
        ))}
      </div>
      <div class="mt-6">
        <a href="/pompelmi/use-cases/" class="text-sm font-medium text-blue-700 hover:text-blue-800">See all use cases</a>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Orientation</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Three comparisons teams ask first</h2>
      </div>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {orientation.map((item) => (
          <a href={item.href} class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-blue-300 hover:bg-white">
            <h3 class="text-lg font-semibold tracking-tight text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Featured in</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">External references that help evaluate the project quickly</h2>
      </div>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {featuredMentions.map((item) => (
          <a href={item.url} target="_blank" rel="noopener" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
              {item.publisher}{item.date ? ` · ${item.date}` : ''}
            </div>
            <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.snippet}</p>
          </a>
        ))}
      </div>
      <div class="mt-6">
        <a href="/pompelmi/featured-in/" class="text-sm font-medium text-blue-700 hover:text-blue-800">See the full featured page</a>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Translations</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">English is the source of truth, but translated resources are available</h2>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-600">
            The public docs and root README are maintained in English. Community-maintained translated READMEs are available for discovery and onboarding without duplicating the whole site.
          </p>
          <div class="mt-5">
            <a href="/pompelmi/translations/" class="text-sm font-medium text-blue-700 hover:text-blue-800">Browse translations</a>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Keep going</p>
          <div class="mt-4 space-y-3 text-sm">
            <a href="/pompelmi/blog/" class="block rounded-md border border-slate-200 bg-white px-3 py-3 font-medium text-slate-900 hover:border-blue-300">Browse the blog</a>
            <a href="/pompelmi/comparisons/" class="block rounded-md border border-slate-200 bg-white px-3 py-3 font-medium text-slate-900 hover:border-blue-300">Read comparisons</a>
            <a href="https://github.com/pompelmi/pompelmi" target="_blank" rel="noopener" class="block rounded-md border border-slate-200 bg-white px-3 py-3 font-medium text-slate-900 hover:border-blue-300">Inspect the source on GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
